# Copy this file to .env and fill in real values for local development.

# Postgres connection string. For local dev, run the docker-compose in this
# repo (see README) which gives you: postgresql://postgres:postgres@localhost:5433/coverpin
# (mapped to host port 5433 to avoid clashing with a default local Postgres on 5432)
# For production, use your Neon pooled connection string (Settings -> Connection Details).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/coverpin

# Port the NestJS server listens on.
PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN=http://localhost:3000

# development | production
NODE_ENV=development

# --- Scaling / limits (all optional; defaults shown below match prior hardcoded values) ---

# Max size, in bytes, accepted for each of the 3 uploaded files.
MAX_UPLOAD_FILE_SIZE_BYTES=10485760

# Max number of data rows accepted in a single uploaded file (excludes header).
# Uploads over this are rejected as a validation error before any row is processed.
MAX_UPLOAD_ROWS_PER_FILE=50000

# Number of rows per batched upsert when writing an upload to the database.
UPLOAD_BATCH_CHUNK_SIZE=500

# --- DB connection pool (all optional) ---

# Max/min concurrent pg connections held by this process's pool.
DB_POOL_MAX=20
DB_POOL_MIN=4
# How long an idle pooled connection is kept open before being closed.
DB_POOL_IDLE_TIMEOUT_MS=30000
# How long to wait for a pooled connection to become available before erroring.
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# --- Per-IP rate limiting (all optional) ---

# Requests allowed per IP within the window below before a 429 is returned.
THROTTLE_LIMIT=600
THROTTLE_TTL_MS=60000
